{
  "cli": {
    "version": ">= 19.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_TV": "1",
        "DEFAULT_LANG": "it"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_TV": "1",
        "DEFAULT_LANG": "it"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_TV": "1",
        "DEFAULT_LANG": "it"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
