# Copy this file to apps/server/.env and customize as needed. Bun loads it
# automatically when the server starts from this directory (`yarn dev:server`).
#
# These are SERVER settings, separate from the root .env, which holds build-time
# values for the TV and mobile apps. On the deployed box these are set in the
# systemd unit instead (Environment=...), and real environment variables always
# win over this file.

# Players allowed in one room. Default 12. The TV lobby only draws seven avatars
# before collapsing the rest into a "+N" badge, and the results screens are laid
# out for a room of about this size — raise it and check the layouts first
# (yarn test:e2e --project="TV Host" renders 50-player screenshots).
# MAX_PLAYERS=12

# Port the server listens on. Default 3000.
# PORT=3000

# Public base URL, used for the join QR and TV login links.
# SERVER_BASE_URL=https://example.com

# Set to 1 to log debug output in production (always on outside production).
# UE_DEBUG=1
