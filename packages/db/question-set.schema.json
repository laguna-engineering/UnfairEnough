{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Unfair Enough! Question Set",
  "description": "YAML question set for Unfair Enough! quiz game",
  "type": "object",
  "required": ["name", "questions"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the question set",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "description": "Who created this set"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the set"
    },
    "defaultTimeLimit": {
      "type": "integer",
      "description": "Default seconds per question (overridable per question)",
      "default": 10,
      "minimum": 1,
      "maximum": 120
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Tags for categorizing the set"
    },
    "questions": {
      "type": "array",
      "description": "List of questions",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text", "options", "correctAnswer"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique ID within this set (for dedup on re-import)"
          },
          "text": {
            "type": "string",
            "description": "The question text",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": ["multiple_choice", "true_false"],
            "default": "multiple_choice",
            "description": "Question type"
          },
          "category": {
            "type": "string",
            "description": "Category (e.g. geography, science, history)"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "maxItems": 10,
            "description": "Tags for difficulty personalization (e.g. zelda, nintendo, gaming). Max 10."
          },
          "timeLimit": {
            "type": "integer",
            "description": "Per-question time limit override (seconds)",
            "minimum": 1,
            "maximum": 120
          },
          "media": {
            "type": "object",
            "description": "Media shown on TV before the question appears",
            "required": ["type", "url"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["image", "audio", "video"]
              },
              "url": {
                "type": "string",
                "description": "URL or relative path to the media file"
              },
              "previewDuration": {
                "type": "integer",
                "description": "Seconds to show media before question appears",
                "default": 5,
                "minimum": 1,
                "maximum": 30
              }
            }
          },
          "options": {
            "type": "array",
            "description": "Answer options (2-4 for multiple_choice, exactly 2 for true_false)",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["key", "text"],
              "properties": {
                "key": {
                  "type": "string",
                  "enum": ["A", "B", "C", "D"],
                  "description": "Answer key"
                },
                "text": {
                  "type": "string",
                  "description": "Answer text"
                }
              }
            }
          },
          "correctAnswer": {
            "type": "string",
            "description": "Key of the correct answer (A-D for multiple_choice, true/false for true_false)"
          },
          "difficulty": {
            "type": "integer",
            "description": "Absolute question difficulty (1=easy, 3=average, 5=hard). Defaults to 3 if omitted.",
            "minimum": 1,
            "maximum": 5,
            "default": 3
          },
          "playerDifficulty": {
            "type": "object",
            "description": "Per-player difficulty ratings (player name -> 1-5 scale). 'default' is the fallback.",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          },
          "explanation": {
            "type": "string",
            "description": "Explanation shown after the answer is revealed (future)"
          }
        }
      }
    }
  }
}
