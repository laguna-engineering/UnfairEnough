# EAS archive exclusions. This file REPLACES .gitignore for `eas build`/
# `eas update` archiving, and exists for exactly two deltas: the TV background
# music (apps/tv-host/assets/music/) is kept out of git but MUST ship in build
# archives, since useBgMusic.ts requires the tracks at bundle time; and the
# root .env, which app.config.ts bakes into `extra` — stripping it made the
# fingerprint runtime version diverge between the local machine and the build
# sandbox. Builds run locally (eas build --local), so .env stays on this machine.
# Keep this in sync with .gitignore when adding new exclusions.
node_modules/
.expo/
dist/
# CNG-generated native projects (regenerated by expo prebuild). Anchored so
# handwritten native code in local expo modules (apps/*/modules/*/android)
# stays tracked — a blanket android/ once swallowed real source.
/ios/
/android/
apps/*/ios/
apps/*/android/
apps/*/modules/*/android/build/
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# SQLite databases
*.db
*.db-shm
*.db-wal
*.db.bak-*

# Environment: .env deliberately NOT excluded here (see header) — it must ship
# in build archives so the sandbox evaluates the same app config as this machine.

# macOS
.DS_Store

# @generated expo-cli sync-2b81b286409207a5da26e14c78851eb30d8ccbdb
# The following patterns were generated by expo-cli

expo-env.d.ts
# @end expo-cli

# Playwright
playwright-report/
test-results/
/playwright/.cache/

# Questions (ignore all except the example)
questions/*
!questions/example.yaml
*.zip

# Background music (bundled into the TV app at build time, kept out of git)
apps/server/music/

# Claude
.claude/*.local.json
.claude/.lint-cache.json
CLAUDE.local.md

# Built web bundles — produced and uploaded separately by the unfairenough-deploy skill
apps/server/public*/

*.parquet
*.log

# design-sync (claude.ai/design import) — staged scripts, build output, machine state
/.ds-sync/
/ds-bundle/
/.design-sync/.cache/
/.design-sync/learnings/
/.design-sync/node_modules

apps/*/build-*.apk
apps/*/build-*.aab
apps/*/build-*.tar.gz
apps/*/build-*.ipa
